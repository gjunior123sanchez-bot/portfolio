<style>
/* =========================================
   EDITABLE WEBSITE THEME
========================================= */
:root {
    --bg: #080d1a;
    --bg2: #0d1426;
    --card: #111c32;
    --blue: #5087ff;
    --indigo: #8065ff;
    --text: #f1f5ff;
    --muted: #9ba9c2;
    --border: rgba(255,255,255,.09);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: 90%;
    max-width: 1150px;
    margin: auto;
}

section {
    padding: 100px 0;
    scroll-margin-top: 75px;
}

.section-title {
    text-align: center;
    margin-bottom: 55px;
}

.section-title span {
    color: var(--blue);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 700;
}

.section-title h2 {
    font-size: clamp(30px, 5vw, 42px);
    margin-top: 10px;
}

.section-title p {
    color: var(--muted);
    margin-top: 10px;
}

.gradient-text {
    background: linear-gradient(100deg, #5b9bff, #9b78ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.btn {
    display: inline-block;
    padding: 13px 25px;
    border-radius: 8px;
    background: linear-gradient(120deg, var(--blue), var(--indigo));
    color: white;
    font-weight: 600;
    transition: .3s;
    border: none;
    cursor: pointer;
}

.btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(80,135,255,.25);
}

.btn-outline {
    background: transparent;
    border: 1px solid var(--blue);
    color: var(--text);
}

/* =========================================
   NAVIGATION
========================================= */
header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(8,13,26,.92);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid var(--border);
}

nav {
    min-height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo span {
    color: var(--blue);
}

.nav-links {
    display: flex;
    gap: 25px;
    list-style: none;
}

.nav-links a {
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    transition: .3s;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--blue);
}

.menu-toggle {
    display: none;
    background: none;
    color: white;
    border: none;
    font-size: 28px;
    cursor: pointer;
}

/* =========================================
   HOME / HERO
========================================= */
#home {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 120px;
    background:
        radial-gradient(ellipse at 85% 20%, rgba(80,100,255,.16), transparent 40%),
        radial-gradient(ellipse at 10% 90%, rgba(80,135,255,.09), transparent 40%);
}

.hero-content {
    display: grid;
    grid-template-columns: 1.4fr .8fr;
    align-items: center;
    gap: 60px;
}

.availability {
    display: inline-block;
    color: #80e7b2;
    background: rgba(50,200,130,.1);
    border: 1px solid rgba(50,200,130,.2);
    padding: 7px 15px;
    border-radius: 30px;
    font-size: 12px;
    margin-bottom: 25px;
}

.hero-text h1 {
    font-size: clamp(38px, 6vw, 65px);
    line-height: 1.15;
    letter-spacing: -2px;
    margin-bottom: 18px;
}

.hero-text h3 {
    font-size: 22px;
    color: var(--muted);
    margin-bottom: 20px;
    font-weight: 500;
}

.hero-text p {
    max-width: 620px;
    color: var(--muted);
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.hero-card {
    background: linear-gradient(145deg, #172644, #10182a);
    border: 1px solid var(--border);
    padding: 40px 25px;
    border-radius: 25px;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0,0,0,.25);
    position: relative;
    overflow: hidden;
}

.hero-card::before {
    content: "";
    position: absolute;
    width: 200px;
    height: 200px;
    background: var(--indigo);
    filter: blur(100px);
    opacity: .2;
    top: -70px;
    right: -50px;
}

.avatar {
    width: 145px;
    height: 145px;
    border-radius: 50%;
    margin: auto auto 20px;
    background: linear-gradient(135deg, #5087ff, #8a63ff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    font-weight: 800;
    border: 5px solid rgba(255,255,255,.12);
    position: relative;
}

.hero-card h3 {
    font-size: 21px;
}

.hero-card p {
    color: var(--muted);
    font-size: 13px;
}

.hero-tags {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 20px;
}

.hero-tags span {
    background: rgba(80,135,255,.12);
    color: #9cbaff;
    padding: 6px 12px;
    font-size: 11px;
    border-radius: 20px;
}

/* =========================================
   ABOUT
========================================= */
.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;
    align-items: stretch;
}

.about-card,
.info-card,
.skill-card,
.timeline-card,
.project-card,
.service-card,
.cert-card,
.contact-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 28px;
    transition: .3s;
}

.about-card:hover,
.info-card:hover,
.skill-card:hover,
.project-card:hover,
.service-card:hover,
.cert-card:hover {
    transform: translateY(-5px);
    border-color: rgba(80,135,255,.5);
}

.about-card p {
    color: var(--muted);
    margin-bottom: 15px;
}

.info-list {
    display: grid;
    gap: 16px;
}

.info-item {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
    font-size: 14px;
}

.info-item span:first-child {
    color: var(--muted);
}

.info-item span:last-child {
    text-align: right;
    font-weight: 600;
}

/* =========================================
   SKILLS
========================================= */
.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.skill-card h3 {
    margin-bottom: 20px;
    font-size: 17px;
}

.skill-card h3 span {
    color: var(--blue);
    margin-right: 10px;
}

.skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.skill-list span {
    background: rgba(80,135,255,.1);
    border: 1px solid rgba(80,135,255,.16);
    color: #bdceff;
    padding: 8px 12px;
    border-radius: 7px;
    font-size: 12px;
}

/* =========================================
   EXPERIENCE TIMELINE
========================================= */
.timeline {
    max-width: 850px;
    margin: auto;
    position: relative;
}

.timeline::before {
    content: "";
    position: absolute;
    left: 12px;
    top: 5px;
    bottom: 5px;
    width: 2px;
    background: linear-gradient(var(--blue), var(--indigo));
}

.timeline-item {
    padding-left: 45px;
    margin-bottom: 30px;
    position: relative;
}

.timeline-item::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 30px;
    width: 16px;
    height: 16px;
    background: var(--blue);
    border-radius: 50%;
    box-shadow: 0 0 15px var(--blue);
}

.timeline-card .date {
    color: var(--blue);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

.timeline-card h3 {
    margin: 7px 0;
    font-size: 20px;
}

.timeline-card h4 {
    color: #a7b7d7;
    font-weight: 500;
    margin-bottom: 12px;
}

.timeline-card p {
    color: var(--muted);
    font-size: 14px;
}

.location {
    font-size: 12px !important;
    margin-top: 10px;
    color: #8295b7 !important;
}

/* =========================================
   PROJECTS
========================================= */
.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.project-card {
    overflow: hidden;
}

.project-icon {
    height: 150px;
    background: linear-gradient(135deg, #182e58, #30255c);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 55px;
    border-radius: 10px;
    margin-bottom: 20px;
}

.project-card h3 {
    margin-bottom: 10px;
}

.project-card p {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 15px;
}

.project-label {
    color: #91b3ff;
    font-size: 11px;
    background: rgba(80,135,255,.12);
    display: inline-block;
    padding: 5px 10px;
    border-radius: 5px;
}

/* =========================================
   EDUCATION
========================================= */
.education-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.education-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 25px;
}

.education-card .year {
    color: var(--blue);
    font-size: 12px;
    font-weight: 700;
}

.education-card h3 {
    margin: 12px 0;
    font-size: 17px;
}

.education-card p {
    color: var(--muted);
    font-size: 13px;
}

/* =========================================
   CERTIFICATIONS
========================================= */
.cert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.cert-card {
    display: flex;
    align-items: flex-start;
    gap: 18px;
}

.cert-icon {
    min-width: 45px;
    height: 45px;
    border-radius: 10px;
    background: rgba(80,135,255,.13);
    display: grid;
    place-items: center;
    font-size: 22px;
}

.cert-card h3 {
    font-size: 15px;
    margin-bottom: 5px;
}

.cert-card p {
    font-size: 12px;
    color: var(--muted);
}

/* =========================================
   SERVICES
========================================= */
.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.service-card {
    text-align: center;
}

.service-icon {
    font-size: 35px;
    margin-bottom: 15px;
}

.service-card h3 {
    margin-bottom: 10px;
    font-size: 18px;
}

.service-card p {
    color: var(--muted);
    font-size: 13px;
}

/* =========================================
   CONTACT
========================================= */
#contact {
    background: linear-gradient(180deg, transparent, rgba(40,70,140,.1));
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
}

.contact-card h3 {
    font-size: 22px;
    margin-bottom: 15px;
}

.contact-card > p {
    color: var(--muted);
    margin-bottom: 25px;
    font-size: 14px;
}

.contact-detail {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
}

.contact-icon {
    width: 43px;
    height: 43px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: rgba(80,135,255,.15);
    font-size: 20px;
}

.contact-detail small {
    color: var(--muted);
    display: block;
}

.contact-detail strong {
    font-size: 14px;
    overflow-wrap: anywhere;
}

.contact-form {
    display: grid;
    gap: 15px;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #0b1426;
    color: white;
    font: inherit;
    outline: none;
}

.contact-form input:focus,
.contact-form textarea:focus {
    border-color: var(--blue);
}

.contact-form textarea {
    min-height: 130px;
    resize: vertical;
}

.contact-form button {
    font: inherit;
}

/* =========================================
   FOOTER
========================================= */
footer {
    background: #060a13;
    border-top: 1px solid var(--border);
    padding: 35px 0;
    text-align: center;
}

footer p {
    color: var(--muted);
    font-size: 13px;
}

.social-links {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin: 18px 0;
}

.social-links a {
    color: #9db9ff;
    font-size: 13px;
}

.social-links a:hover {
    color: white;
}

.back-top {
    position: fixed;
    right: 25px;
    bottom: 25px;
    width: 43px;
    height: 43px;
    border: none;
    border-radius: 10px;
    background: var(--blue);
    color: white;
    font-size: 20px;
    cursor: pointer;
    display: none;
    z-index: 500;
}

/* =========================================
   ANIMATIONS
========================================= */
.reveal {
    opacity: 0;
    transform: translateY(25px);
    transition: opacity .7s ease, transform .7s ease;
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}

/* =========================================
   RESPONSIVE DESIGN
========================================= */
@media(max-width: 950px) {
    .nav-links {
        gap: 13px;
    }

    .nav-links a {
        font-size: 11px;
    }

    .skills-grid,
    .services-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media(max-width: 760px) {
    section {
        padding: 75px 0;
    }

    .menu-toggle {
        display: block;
    }

    .nav-links {
        position: absolute;
        top: 75px;
        left: 0;
        width: 100%;
        background: #0d1426;
        display: none;
        flex-direction: column;
        padding: 25px 5%;
        border-bottom: 1px solid var(--border);
        gap: 18px;
    }

    .nav-links.show {
        display: flex;
    }

    .nav-links a {
        font-size: 14px;
    }

    .hero-content,
    .about-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .hero-content {
        gap: 40px;
    }

    .hero-text {
        text-align: center;
    }

    .hero-text p {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-card {
        max-width: 400px;
        margin: auto;
        width: 100%;
    }

    .projects-grid,
    .education-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .cert-grid {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 500px) {
    .skills-grid,
    .projects-grid,
    .education-grid,
    .services-grid {
        grid-template-columns: 1fr;
    }

    .hero-text h1 {
        font-size: 39px;
    }

    .info-item {
        font-size: 12px;
    }

    .about-card,
    .info-card,
    .skill-card,
    .timeline-card,
    .project-card,
    .service-card,
    .cert-card,
    .contact-card {
        padding: 20px;
    }
}
</style>
</head>

